CREATE USER disk_size_info_user@localhost;
GRANT SELECT ON *.* TO disk_size_info_user@localhost;
connect  con1,localhost,disk_size_info_user,,;
connection con1;
SELECT COUNT(*) FROM information_schema.DISK_SIZE_INFO;
COUNT(*)
0
disconnect con1;
connection default;
GRANT FILE ON *.* TO disk_size_info_user@localhost;
connect  con1,localhost,disk_size_info_user,,;
connection con1;
SELECT COUNT(*) > 0 AS has_rows FROM information_schema.DISK_SIZE_INFO;
has_rows
1
disconnect con1;
connection default;
DROP USER disk_size_info_user@localhost;
